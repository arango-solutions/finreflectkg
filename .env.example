# -- ArangoDB connection -------------------------------------------------------
# Endpoint of your ArangoDB 3.12.x Enterprise deployment.
ARANGO_ENDPOINT=https://your-arango-endpoint:8529
ARANGO_DB=FinReflectKG
ARANGO_USER=root
ARANGO_PASSWORD=changeme
# Set to false only for self-signed certs in trusted/dev environments.
ARANGO_VERIFY_SSL=true
ARANGO_TIMEOUT=120

# -- Arango Container Manager (BYOC demo) -------------------------------------
# Do NOT set these for local uvicorn — the values above are used instead.
# Inside Container Manager the platform injects ARANGO_DEPLOYMENT_ENDPOINT
# (cluster-internal URL) and forwards the request JWT. Optional sidecar token:
# ARANGO_TOKEN=/var/run/secrets/arango/token/token

# -- Dataset -------------------------------------------------------------------
# Hugging Face dataset id (downloaded by scripts/download.py).
HUGGINGFACE_DATASET=domyn/FinReflectKG

# -- LLM (optional; NL->AQL + GraphRAG, scripts/llm.py) ------------------------
# Leave unset to run the M5 pipelines in dry-run (retrieval + prompt assembly only).
# Set ONE provider; LLM_PROVIDER auto-detects from whichever key is present.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
