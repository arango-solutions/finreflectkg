# Secrets / environment
.env
.env.*
!.env.example

# Claude Code personal/local files
CLAUDE.local.md
.claude/settings.local.json

# Python
.venv/
.venv311/
__pycache__/

# Dataset artifacts (downloaded / generated, ~GBs)
data/raw/
data/staging/
data/*.json

# Generated doc exports (HTML/PDF rendered from docs/*.md)
docs/export/

# BYOC packaging output (regenerable via ./scripts/package_byoc.sh)
dist/

# Runtime artifact from arango-cypher-py's NL entity resolver (regenerable)
nl_corrections.db

# OS
.DS_Store
.prd-drift-queue/
.claude/
CLAUDE.md
.no-drift-gate
.cursor/.shared-memory-sessions/
.cursor/hooks.json.pre-update.*
.cursor/hooks/*.pre-update.*

# Generated run artifacts under data/ (logs, agentic checkpoints, rendered reports).
# data/raw + data/staging are already ignored above; these are the remaining ~2 MB of
